// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native = build host; linux-musl = Alpine production image
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkItemKind {
  Incident
  Issue
  Task
}

enum WorkItemPriority {
  none
  low
  medium
  high
  urgent
}

enum WorkItemRole {
  Developer
  infra
  SA
}

enum WorkItemStatus {
  backlog
  todo
  in_progress @map("in-progress")
  blocked
  sa_testing  @map("sa-testing")
  pm_testing  @map("pm-testing")
  completed
  cancelled
}

// User and Authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("member") // member, manager, admin
  avatar    String?
  phone     String?
  status    String   @default("Active") // Active, Inactive, Away
  joinDate  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedWorkItems  WorkItem[]          @relation("WorkItemAssignee")
  projectMemberships ProjectMember[]
  comments           Comment[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  timeEntries        TimeEntry[]
  createdProjects    Project[]           @relation("ProjectCreator")
  documents          Document[]

  @@index([email])
}

// Company Information
model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  email       String?
  phone       String?
  address     String?
  website     String?
  logo        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Project
model Project {
  id           String   @id @default(cuid())
  name         String
  description  String?
  status       String   @default("Planning") // Planning, In Progress, Review, Completed, On Hold
  priority     String   @default("Medium") // Low, Medium, High, Critical
  startDate    DateTime
  dueDate      DateTime
  budget       Decimal?
  spent        Decimal? @default(0)
  progress     Int      @default(0) // 0-100
  colorProject String? // Project color for visual identification
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creatorId    String?
  creator      User?           @relation("ProjectCreator", fields: [creatorId], references: [id])
  members      ProjectMember[]
  workItems    WorkItem[]
  documents    Document[]
  milestones   Milestone[]
  activityLogs ActivityLog[]
  timeEntries  TimeEntry[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
}

// Project Members
model ProjectMember {
  id       String   @id @default(cuid())
  role     String   @default("member") // member, lead, manager
  joinedAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model WorkItem {
  id          String           @id @default(cuid())
  title       String
  description String?
  kind        WorkItemKind
  priority    WorkItemPriority @default(none)
  role        WorkItemRole?
  status      WorkItemStatus   @default(backlog)
  types       String[]         @default([]) @map("labels_types")
  workDate    DateTime?
  dueDate     DateTime?
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String
  assignee   User    @relation("WorkItemAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([assigneeId])
  @@index([kind])
  @@index([status])
  @@index([priority])
  @@map("work_items")
}

// Comment
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// Milestone
model Milestone {
  id          String   @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime
  status      String   @default("Not Started") // Not Started, In Progress, Completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Document
model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  fileUrl     String
  fileSize    Int? // in bytes
  fileType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id])

  @@index([projectId])
  @@index([uploaderId])
}

// Time Entry
model TimeEntry {
  id          String   @id @default(cuid())
  description String?
  remarks     String?
  hours       Decimal
  date        DateTime @default(now())
  status      String? // To Do, In Progress, Review, Completed, Blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([date])
}

// Activity Log
model ActivityLog {
  id          String   @id @default(cuid())
  action      String // created, updated, deleted, commented, assigned, etc.
  entity      String // project, work_item, etc.
  entityId    String
  description String?
  metadata    Json? // Additional data about the action
  createdAt   DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Notification
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
