// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native = build host; linux-musl = Alpine production image
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkItemKind {
  Incident
  Issue
  Task
}

enum WorkItemPriority {
  none
  low
  medium
  high
  urgent
}

enum WorkItemRole {
  Developer
  infra
  SA
}

enum WorkItemStatus {
  backlog
  todo
  in_progress @map("in-progress")
  blocked
  sa_testing  @map("sa-testing")
  pm_testing  @map("pm-testing")
  completed
  cancelled
}

enum UserTheme {
  light
  dark
  special_dark @map("special-dark")
}

enum UserLocale {
  th
  en
}

// User and Authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("member") // member, manager, admin
  avatar    String?
  phone     String?
  theme     UserTheme  @default(light)
  locale    UserLocale @default(th)
  status    String   @default("Active") // Active, Inactive, Away
  joinDate  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedWorkItems  WorkItem[]      @relation("WorkItemAssignee")
  projectMemberships ProjectMember[]
  comments           Comment[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  timeEntries        TimeEntry[]
  createdProjects    Project[]       @relation("ProjectCreator")
  documents          Document[]

  @@index([email])
}

// Company Information
model Company {
  id          String    @id @default(cuid())
  code        String?   @unique // Reserved stable code for Dhas; other Companies may leave it unset.
  displayName String? // Dhas
  location    String?
  name        String
  industry    String?
  email       String?
  phone       String?
  address     String?
  website     String?
  logo        String?
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @db.Timestamp(3)
  projects    Project[]
}

// Project
model Project {
  id           String   @id @default(cuid())
  name         String
  description  String?
  status       String   @default("Planning") // Planning, In Progress, Review, Completed, On Hold
  priority     String   @default("Medium") // Low, Medium, High, Critical
  startDate    DateTime @db.Date
  dueDate      DateTime @db.Date
  budget       Decimal?
  spent        Decimal? @default(0)
  progress     Int      @default(0) // 0-100
  colorProject String? // Project color for visual identification
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)

  creatorId             String?
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator               User?                  @relation("ProjectCreator", fields: [creatorId], references: [id])
  members               ProjectMember[]
  workItems             WorkItem[]
  documents             Document[]
  milestones            Milestone[]
  activityLogs          ActivityLog[]
  timeEntries           TimeEntry[]
  gitLabProjectMappings GitLabProjectMapping[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([companyId, status])
}

// Project Members
model ProjectMember {
  id       String   @id @default(cuid())
  role     String   @default("member") // member, lead, manager
  joinedAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model WorkItem {
  id          String           @id @default(cuid())
  title       String
  description String?
  kind        WorkItemKind
  priority    WorkItemPriority @default(none)
  role        WorkItemRole?
  status      WorkItemStatus   @default(backlog)
  types       String[]         @default([]) @map("labels_types")
  workDate    DateTime?        @db.Date
  dueDate     DateTime?        @db.Date
  submittedAt DateTime?        @db.Timestamp(3)
  createdAt   DateTime         @default(now()) @db.Timestamp(3)
  updatedAt   DateTime         @updatedAt @db.Timestamp(3)

  projectId         String
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assigneeId        String
  assignee          User                       @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  timeEntries       TimeEntry[]
  externalReference ExternalWorkItemReference?

  @@index([projectId])
  @@index([assigneeId])
  @@index([kind])
  @@index([status])
  @@index([priority])
  @@index([workDate])
  @@index([dueDate])
  @@index([createdAt])
  @@map("work_items")
}

// Mapping is owner-managed. Deleting it never deletes imported WorkItems or references.
model GitLabProjectMapping {
  id                         String    @id @default(cuid())
  canonicalGitLabInstanceUrl String
  gitLabProjectId            String
  projectId                  String
  approvedLabelMap           Json      @default("{}") @db.JsonB
  firstSyncApprovedAt        DateTime? @db.Timestamp(3)
  createdAt                  DateTime  @default(now()) @db.Timestamp(3)
  updatedAt                  DateTime  @updatedAt @db.Timestamp(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([canonicalGitLabInstanceUrl, gitLabProjectId])
  @@index([projectId])
}

// Kept independent of GitLabProjectMapping so unmapping retains external identity and history.
model ExternalWorkItemReference {
  id                         String   @id @default(cuid())
  provider                   String   @default("gitlab")
  canonicalGitLabInstanceUrl String
  gitLabProjectId            String
  gitLabGlobalIssueId        String
  gitLabIssueIid             String
  externalUrl                String
  projectId                  String
  remoteCreatedAt            DateTime @db.Timestamp(3)
  remoteUpdatedAt            DateTime @db.Timestamp(3)
  lastSyncedAt               DateTime @db.Timestamp(3)
  workItemId                 String   @unique
  workItem                   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)

  @@unique([provider, canonicalGitLabInstanceUrl, gitLabProjectId, gitLabGlobalIssueId])
  @@index([projectId])
}

// Comment
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// Milestone
model Milestone {
  id          String   @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime
  status      String   @default("Not Started") // Not Started, In Progress, Completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
}

// Document
model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  fileUrl     String
  fileSize    Int? // in bytes
  fileType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id])

  @@index([projectId])
  @@index([uploaderId])
}

// Time Entry
model TimeEntry {
  id          String   @id @default(cuid())
  description String?
  remarks     String?
  hours       Decimal  @db.Decimal(65, 30)
  date        DateTime @default(now()) @db.Date
  status      String? // To Do, In Progress, Review, Completed, Blocked
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workItemId String?
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([projectId])
  @@index([workItemId])
  @@index([date])
}

// Activity Log
model ActivityLog {
  id          String   @id @default(cuid())
  action      String // created, updated, deleted, commented, assigned, etc.
  entity      String // project, work_item, etc.
  entityId    String
  description String?
  metadata    Json? // Additional data about the action
  createdAt   DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([projectId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Notification
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
