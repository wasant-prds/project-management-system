# Copy to scripts/github/.env and set your GitHub token.
# GitHub scripts use this config; root .env is ignored.
GITHUB_URL=https://github.com
GITHUB_REPO=wasant-prds/project-management-system
GITHUB_TOKEN=

# Assignee priority: --assignee > role login > GITHUB_ASSIGNEE > wasant-prds.
GITHUB_ASSIGNEE=wasant-prds
GITHUB_ASSIGNEE_SA=
GITHUB_ASSIGNEE_INFRA=
GITHUB_ASSIGNEE_DEVELOPER=
GITHUB_ASSIGNEE_DEVELOPER_INFRA=
GITHUB_ASSIGNEE_DEVELOPER_DATA_MIGRATION=
