# Production Environment Variables
# Copy this file to .env.production and update with actual production values
# IMPORTANT: Never commit actual production secrets to version control!

# Node Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# Database Configuration
# Use connection pooling in production for better performance
DATABASE_URL="postgresql://prod_user:STRONG-PASSWORD-HERE@db-host:5432/project_management_prod?schema=public&connection_limit=10&pool_timeout=20"

# PostgreSQL Settings (for Docker Compose)
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=STRONG-SECURE-PASSWORD-CHANGE-THIS
POSTGRES_DB=project_management_prod
POSTGRES_PORT=5434

# NextAuth Configuration
NEXTAUTH_SECRET=GENERATE-STRONG-SECRET-MIN-64-CHARACTERS-USE-openssl-rand-base64-64
NEXTAUTH_URL=https://yourdomain.com

# Application Settings
APP_PORT=3002
HOSTNAME=0.0.0.0

# API URLs
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Email Configuration
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-production-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png
UPLOAD_PATH=/app/uploads

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Session Configuration
SESSION_TIMEOUT=7200000
SECURE_COOKIES=true

# Security Headers
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Monitoring & Logging
LOG_LEVEL=error
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Cache Configuration
REDIS_URL=redis://redis:6379
CACHE_TTL=3600

# CDN Configuration (if using)
CDN_URL=https://cdn.yourdomain.com
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXX-X
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Database Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT=30000

