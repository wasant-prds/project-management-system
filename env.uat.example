# UAT Environment Variables
# Copy this file to .env.uat and update values
#
# Database credentials come from Docker secrets (./secrets/*.txt), not this file.
# See secrets/README.md for setup.

# Node Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=uat

# NextAuth Configuration
NEXTAUTH_SECRET=generate-secure-secret-min-32-characters-for-uat
NEXTAUTH_URL=http://localhost:3001

# Host port mappings
APP_PORT=3001
POSTGRES_PORT=5433
APP_ENV=uat
POSTGRES_DATA_DIR=./database/postgres/data
POSTGRES_RESTART=unless-stopped
SEED_PATH=seeds/master
RUN_SEED=true
