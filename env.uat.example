# UAT Environment Variables
# Copy this file to .env.uat and update with actual UAT values

# Node Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=uat

# Database Configuration
DATABASE_URL="postgresql://postgres:your-secure-password@localhost:5433/project_management_uat?schema=public"

# PostgreSQL Settings (for Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=project_management_uat
POSTGRES_PORT=5433

# NextAuth Configuration
NEXTAUTH_SECRET=generate-secure-secret-min-32-characters-for-uat
NEXTAUTH_URL=https://uat.yourdomain.com

# Application Settings
APP_PORT=3001

# API URLs
NEXT_PUBLIC_API_URL=https://uat.yourdomain.com/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Email Configuration (if needed)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-smtp-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Session Configuration
SESSION_TIMEOUT=3600000

