# Production Environment Variables
# Copy this file to .env.production and update with actual production values
# IMPORTANT: Never commit actual production secrets to version control!
#
# Database credentials come from Docker secrets (./secrets/*.txt), not this file.
# See secrets/README.md for setup.

# Node Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# NextAuth Configuration
# Generate with: openssl rand -base64 64
NEXTAUTH_SECRET=GENERATE-STRONG-SECRET-MIN-64-CHARACTERS-USE-openssl-rand-base64-64
NEXTAUTH_URL=https://yourdomain.com

# Host port mappings
APP_PORT=3002
POSTGRES_PORT=5434
APP_ENV=prod
POSTGRES_DATA_DIR=./database/postgres/data
POSTGRES_RESTART=always
SEED_PATH=seeds/master
RUN_SEED=false

# Backup service (optional: bash scripts/docker-prod.sh start-backup)
BACKUP_KEEP_DAYS=30
