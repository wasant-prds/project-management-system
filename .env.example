# All runtime configuration lives in this single root .env.
# Never commit .env or use NEXT_PUBLIC_* for credentials.
APP_ENV=dev
TZ=Asia/Bangkok
NEXT_PUBLIC_ENV=development
APP_PORT=3777
APP_ORIGIN=http://localhost:3777
# UAT: APP_ENV=uat, APP_PORT=3001, NEXT_PUBLIC_ENV=uat
# Production: APP_ENV=prod, APP_PORT=3002, NEXT_PUBLIC_ENV=production
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD='<database-password>'
POSTGRES_DB=<database-name>
POSTGRES_PORT=5437
POSTGRES_DATA_DIR=./database/postgres/data
POSTGRES_RESTART=unless-stopped
SEED_PATH=database/seeds/master
RUN_SEED=false
BACKUP_KEEP_DAYS=30
OWNER_GATE_USERNAME=owner
OWNER_GATE_PASSWORD='<random-password-at-least-32-characters>'
# Both URL and token, or both blank to disable GitLab.
GITLAB_BASE_URL=
GITLAB_TOKEN=
# Local pnpm only: optional URL; Docker derives it from POSTGRES_* above.
# DATABASE_URL=postgresql://<encoded-user>:<encoded-password>@127.0.0.1:5437/<database>
