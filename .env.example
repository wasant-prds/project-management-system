# ==============================================================================
# Single Root Environment Configuration (.env.example)
#
# Copy this file to `.env` at the repository root and customize values for your
# environment (local, dev, uat, prod). Docker Compose and runtime helpers read
# this single root file.
#
# SECURITY & RUNTIME RULES:
# - Never commit `.env` or use NEXT_PUBLIC_* for credentials, tokens, or secrets.
# - Keep credentials as placeholders in this example file.
# - System default timezone is strictly Asia/Bangkok across all environments,
#   application sessions, and database sessions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Settings
# ------------------------------------------------------------------------------
# Target environment: local | dev | uat | prod
APP_ENV=dev

# System timezone (enforced: Asia/Bangkok)
TZ=Asia/Bangkok

# Client bundle environment label: development | uat | production
# (Note: Dockerfile bakes this at build time via build arg)
NEXT_PUBLIC_ENV=development

# Host port mapping for application
# Dev: 3000 | UAT: 3001 | Production: 3002
APP_PORT=3000

# Application origin URL for browser access and owner gate validation.
# MUST match the browser URL origin exactly (scheme, host, port).
# Note: 127.0.0.1 and localhost are treated as different origins.
# Dev: http://127.0.0.1:3000 (or http://localhost:3000 if accessed via localhost)
# UAT: http://127.0.0.1:3001
# Production: https://<your-production-domain>
APP_ORIGIN=http://127.0.0.1:3000

# Optional: Node environment (automatically set by Next.js and Docker Compose)
# NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Settings (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD='<database-password>'
POSTGRES_DB=<database-name>

# Host port mapping for PostgreSQL container (default: 5437)
POSTGRES_PORT=5437

# Host directory for PostgreSQL persistent data volume
POSTGRES_DATA_DIR=./database/postgres/data

# PostgreSQL container restart policy (unless-stopped | always)
POSTGRES_RESTART=unless-stopped

# ------------------------------------------------------------------------------
# 3. Database Connection (Local pnpm / Prisma Tooling)
# ------------------------------------------------------------------------------
# In Docker, DATABASE_URL is constructed automatically from POSTGRES_* above.
# For local read-only tooling (e.g. pnpm prisma studio):
# - Connecting to Docker PostgreSQL on host port 5437:
# DATABASE_URL="postgresql://<database-user>:<database-password>@127.0.0.1:5437/<database-name>?schema=public&options=--timezone%3DAsia%2FBangkok"
# - Connecting to standalone local PostgreSQL on default port 5432:
# DATABASE_URL="postgresql://<database-user>:<database-password>@localhost:5432/<database-name>?schema=public&options=--timezone%3DAsia%2FBangkok"

# ------------------------------------------------------------------------------
# 4. Database Migrations & Seeds
# ------------------------------------------------------------------------------
# Path to master seeds relative to repository root (or /app inside container)
SEED_PATH=database/seeds/sql-master

# SQL master seeding requires a verified dataset and empty business tables.
# Check files without writing to the database:
#   node scripts/sql-seeds.mjs verify-dataset
# For an approved fresh install, set RUN_SEED=true, DB_SEED_APPROVED=true,
# DB_SEED_APPROVED_ENV=<APP_ENV>, and copy datasetFingerprint from
# database/seeds/sql-master/manifest.json into DB_SEED_APPROVED_FINGERPRINT.
# After successful seeding, set RUN_SEED=false before the next startup.
RUN_SEED=false
DB_SEED_APPROVED=false
DB_SEED_APPROVED_ENV=
DB_SEED_APPROVED_FINGERPRINT=

# Optional: Maximum retry attempts for migration service (default: 3)
# MIGRATION_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 5. Database Schema Rollout Approval Gate
# ------------------------------------------------------------------------------
# SQL migrations require exactly one verified baseline and explicit approval.
# Fresh install ONLY after confirming the selected database is empty:
#   DB_SCHEMA_EMPTY_DATABASE_VERIFIED=true
#   DB_SCHEMA_BACKUP_RESTORE_VERIFIED=false
#   DB_SCHEMA_BACKUP_RESTORE_RECEIPT_PATH= (leave blank; no receipt is required)
# Existing database: require a new backup and successful isolated restore;
# select backup verification and keep empty verification false. Receipt path:
#   /run/pms-rollout-backups/<archive>.dump.verified.json
# The archive and its .json manifest must accompany the receipt in BACKUP_DIR.
# Receipt must match APP_ENV and be verified within the last 24 hours.
# Legacy CUID databases require reviewed conversion before this build is used.
#
# Review approval values for the current schema, migration set and exact target.
# This command only prints fingerprints; it does not run migrations:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps --entrypoint sh migrations -c 'export DATABASE_URL="$(node scripts/database-url.mjs)"; node scripts/db-schema-rollout-gate.mjs fingerprint'
# Use the Compose file for your environment. Copy its output to the fields below,
# then set DB_SCHEMA_SYNC_APPROVED_ENV=<APP_ENV> and DB_SCHEMA_SYNC_APPROVED=true.
# Recompute approvals whenever the target, schema or migrations change.
# See document/handbook/database/issue-33-sql-runtime.md for rollout procedure.
DB_SCHEMA_BACKUP_RESTORE_VERIFIED=false
DB_SCHEMA_BACKUP_RESTORE_RECEIPT_PATH=
DB_SCHEMA_EMPTY_DATABASE_VERIFIED=false
DB_SCHEMA_SYNC_APPROVED=false
DB_SCHEMA_SYNC_APPROVED_ENV=
DB_SCHEMA_SYNC_APPROVED_TARGET_SHA256=
DB_SCHEMA_SYNC_APPROVED_SCHEMA_SHA256=
DB_SCHEMA_SYNC_APPROVED_SQL_SHA256=
DB_SCHEMA_SYNC_APPROVED_REVISION=
DB_SCHEMA_SYNC_APPROVED_MIGRATIONS_SHA256=
DB_SCHEMA_SYNC_APPROVED_RELEASE_SHA256=

# ------------------------------------------------------------------------------
# 6. Database Backup & Retention
# ------------------------------------------------------------------------------
# Directory for database backups (relative to repository root or absolute path)
BACKUP_DIR=./database/backups/postgres_data

# Backup retention in days (integer: 1-3650, default: 30)
BACKUP_KEEP_DAYS=30

# ------------------------------------------------------------------------------
# 7. Owner Gate Authentication (HTTP Basic & Single-Owner Access)
# ------------------------------------------------------------------------------
OWNER_GATE_USERNAME=owner

# Must be a secure random password of at least 32 characters
OWNER_GATE_PASSWORD='<random-password-at-least-32-characters>'

# Required when more than one User exists (sql-master contains multiple Users).
# Use the selected owner's immutable UUIDv4 from users.public_id; never use
# a numeric internal ID or generate a new UUID for this setting.
# The UUID must already belong to that user in the target database.
# For a fresh seed install, the reviewed seed mapping
# database/seeds/sql-master/legacy-id-map.json identifies the corresponding
# User newPublicId. Verify that UUID exists in the seeded database.
# Legacy IDs require a separate reviewed live mapping; seed mappings are not
# accepted as runtime live identity authorization.
OWNER_USER_ID=

# ------------------------------------------------------------------------------
# 8. GitLab Integration (One-Way WorkItem & Time-Tracking Import)
# ------------------------------------------------------------------------------
# Both URL and token must be set together, or both left blank to disable GitLab.
# GITLAB_BASE_URL must use HTTPS (e.g. https://gitlab.com or https://gitlab.example.com).
GITLAB_BASE_URL=
GITLAB_TOKEN=

# ------------------------------------------------------------------------------
# 9. Optional Integrations & Feature Flags
# ------------------------------------------------------------------------------
# Vercel Web Analytics (only when deployed on Vercel; self-hosted/Docker ignores this)
# VERCEL_ANALYTICS_ENABLED=false
