# Project Environment Variables
# Copy this file to .env and update values
# Database scripts and Docker Compose use this value to select one site.
# Supported values: local, dev, uat, prod
APP_ENV=prod

# Node Environment
# NODE_ENV=development
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# Database Configuration
DATABASE_URL="????"

# If using Docker:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/project_management?schema=public"

# PostgreSQL Settings (for Docker Compose)
POSTGRES_USER=???
POSTGRES_PASSWORD=???
POSTGRES_DB=???
POSTGRES_PORT=5437
POSTGRES_DATA_DIR=./database/postgres/data
POSTGRES_RESTART=unless-stopped
SEED_PATH=seeds/master
RUN_SEED=true

# NextAuth Configuration (if implementing authentication)
NEXTAUTH_SECRET=???
NEXTAUTH_URL=https://localhost:3002

# Application Settings
APP_PORT=3002

# API URLs (if needed)
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true


# Backup service (optional: npm run docker:prod:start-backup)
BACKUP_KEEP_DAYS=30
