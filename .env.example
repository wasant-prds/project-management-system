# Copy to .env and configure your environment.
# Never commit .env or expose secrets through NEXT_PUBLIC_*.

# Environment: local | dev | uat | prod.
APP_ENV=dev

# Required timezone: Asia/Bangkok.
TZ=Asia/Bangkok

# Browser build label: development | uat | production; Compose sets this per environment.
NEXT_PUBLIC_ENV=development

# Application host port.
APP_PORT=3000

# Exact browser origin (scheme, host, port); localhost differs from 127.0.0.1.
APP_ORIGIN=http://127.0.0.1:3000

# PostgreSQL (Docker Compose)
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD='<database-password>'
POSTGRES_DB=<database-name>

# PostgreSQL host port; the container uses 5432.
POSTGRES_PORT=5437

# Persistent database directory on the host.
POSTGRES_DATA_DIR=./database/postgres/data

POSTGRES_RESTART=unless-stopped

# Local database tools; Docker builds DATABASE_URL from POSTGRES_*.
# DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:5437/<db>?options=--timezone%3DAsia%2FBangkok"

# Seed dataset path, relative to the repository root (/app in Docker).
SEED_PATH=database/seeds/sql-master

# Use true only for an approved fresh install with verified seeds and empty business tables.
# Set false after seeding.
RUN_SEED=false

# Allow schema.sql initialization of an EMPTY database only. Existing mismatched schemas are refused.
DB_SCHEMA_SYNC_APPROVED=false

# Backup directory for verified archives.
BACKUP_DIR=./database/backups/postgres_data

# Retention: 1-3650 days.
BACKUP_KEEP_DAYS=30

# Owner authentication
OWNER_GATE_USERNAME=owner

# Random password, at least 32 characters.
OWNER_GATE_PASSWORD='<random-password-at-least-32-characters>'

# Existing owner's users.public_id (UUIDv4); required when multiple users exist.
# Never use an internal numeric ID or a newly generated UUID.
OWNER_USER_ID=

# Optional default tokens; provider instance URLs come from database mappings.
GITLAB_TOKEN=
GITHUB_TOKEN=

# Each issue_sync_configs.token_env_var names its token variable below.
# Custom names use GITLAB_, GITHUB_ or ISSUE_SYNC_ and include TOKEN.
# Docker app loads these variables from root .env automatically.
# GITLAB_PROJECT_A_TOKEN=
# GITHUB_PROJECT_B_TOKEN=


# Production HTTPS: bash infra/certbot/setup-https.sh.
# APP_ORIGIN must match https://<DOMAIN>.
# Cloudflare token: Zone DNS Read, Zone Settings Edit, Config Rules Edit (this zone only).
# DOMAIN=pms.example.com
# EMAIL=you@example.com
# CF_ZONE_ID=<32-character zone id>
# CF_API_TOKEN=<cloudflare-api-token>
# Use 1 for Let's Encrypt staging (not browser-trusted).
# CERTBOT_STAGING=0
