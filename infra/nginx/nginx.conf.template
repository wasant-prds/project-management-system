# Production TLS proxy for one hostname. envsubst replaces ${DOMAIN} only.
user nginx;
worker_processes 1;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 256;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent"';

  access_log /var/log/nginx/access.log main;

  sendfile on;
  server_tokens off;
  keepalive_timeout 65;
  client_max_body_size 8m;

  limit_req_zone $binary_remote_addr zone=pms_general:1m rate=10r/s;
  limit_req_status 429;

  include /etc/nginx/cloudflare-real-ip.conf;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  resolver 127.0.0.11 valid=10s ipv6=off;

  upstream pms_app {
    zone pms_app 64k;
    server app:3000 resolve;
  }

  server {
    listen 80;
    server_name ${DOMAIN};

    # $realip_remote_addr is the TCP peer. allow/deny after real_ip would see the visitor and block Cloudflare.
    if ($pms_cloudflare_client = 0) {
      return 403;
    }

    location /.well-known/acme-challenge/ {
      default_type text/plain;
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    if ($pms_cloudflare_client = 0) {
      return 403;
    }

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:PmsSSL:1m;

    # Cloudflare "Always Use HTTPS" can redirect the HTTP-01 challenge to 443.
    location /.well-known/acme-challenge/ {
      default_type text/plain;
      root /var/www/certbot;
    }

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=63072000" always;

    location / {
      limit_req zone=pms_general burst=40 nodelay;

      proxy_pass http://pms_app;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Origin $http_origin;
      proxy_set_header Authorization $http_authorization;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
  }
}
