# Development Environment Variables
# Copy this file to .env.development and update values

# Node Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_management_dev?schema=public"

# If using Docker:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/project_management_dev?schema=public"

# PostgreSQL Settings (for Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_management_dev
POSTGRES_PORT=5432

# NextAuth Configuration (if implementing authentication)
NEXTAUTH_SECRET=dev-secret-change-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Application Settings
APP_PORT=3000

# API URLs (if needed)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

